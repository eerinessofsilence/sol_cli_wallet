# Solana RPC endpoint used by the CLI and desktop application.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional CSV file containing wallet addresses for batch operations.
CSV_FILE=wallets.csv

# Optional local desktop-backend overrides.
SOL_WALLET_BACKEND_HOST=127.0.0.1
SOL_WALLET_BACKEND_PORT=8765
